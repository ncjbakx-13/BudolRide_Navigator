# Copy to backend/.env for local development. Do not commit the copied file.
APP_ENV=development
LOG_LEVEL=INFO

# Use a least-privilege application database role, never the Supabase service-role key.
DATABASE_URL=postgresql+psycopg://budolride_app:change-me@localhost:5432/budolride

# Validate access tokens against the expected Supabase issuer and audience.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Development defaults. Production values must be explicit HTTPS origins.
OSRM_BASE_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:8081
